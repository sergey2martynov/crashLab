{
  "uid": "crashlab-overview",
  "title": "CrashLab — Overview",
  "tags": ["crashlab"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Активные WS-подключения (RealTimeGateway, по реплике)",
      "description": "game_connections_active — Фаза 1/2/6, по инстансу (5109/5110), полезно для хаос-теста и sticky-session балансировки",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "game_connections_active",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Тики игрового цикла / сек (все столы)",
      "description": "rate(game_ticks_total) — Фаза 1/5, суммарно по всем столам (метка стола не пишется)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(game_ticks_total[1m])",
          "legendFormat": "ticks/s"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency bet/cashout — p50/p95/p99",
      "description": "game_bet_duration_milliseconds — Фаза 1/3, общий гистограммный замер (bet и cashout вместе, отдельной метки типа запроса нет). Ключевая панель для Фазы 7 (sustained-прогон)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(game_bet_duration_milliseconds_bucket[1m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(game_bet_duration_milliseconds_bucket[1m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum(rate(game_bet_duration_milliseconds_bucket[1m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Bet/cashout — запросов/сек",
      "description": "rate(game_bet_duration_milliseconds_count) — суммарный RPS обоих эндпоинтов",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(game_bet_duration_milliseconds_count[1m])",
          "legendFormat": "req/s"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Settlement — обработано / не удалось",
      "description": "settlement_events_consumed_total / settlement_events_failed_total — Фаза 4, по топику Kafka",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(settlement_events_consumed_total[1m])",
          "legendFormat": "consumed {{topic}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(settlement_events_failed_total[1m])",
          "legendFormat": "failed {{topic}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Settlement duration p95 (по топику)",
      "description": "settlement_event_duration_milliseconds — Фаза 4",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(settlement_event_duration_milliseconds_bucket[1m])) by (le, topic))",
          "legendFormat": "{{topic}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Bets settled / сек (по статусу)",
      "description": "settlement_bets_settled_total — Фаза 4, статус = win/loss/etc из BetSettled()",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(settlement_bets_settled_total[1m])",
          "legendFormat": "{{status}}"
        }
      ]
    }
  ]
}
