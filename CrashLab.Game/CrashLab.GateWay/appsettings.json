{
  "ReverseProxy": {
    "Routes": {
      "realtime-route": {
        "ClusterId": "realtime-cluster",
        "Match": {
          "Path": "/{**catch-all}"
        }
      },
      "bets-route": {
        "ClusterId": "gameengine-cluster",
        "Match": {
          "Path": "/bets/{**catch-all}"
        },
        "RateLimiterPolicy": "bets-per-user"
      }
    },
    "Clusters": {
      "realtime-cluster": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:05",
            "Timeout": "00:00:03",
            "Path": "/health"
          }
        },
        "SessionAffinity": {
          "Enabled": true,
          "Policy": "Cookie",
          "FailurePolicy": "Redistribute",
          "AffinityKeyName": "CrashLab.Affinity"
        },
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5109"
          },
          "destination2": {
            "Address": "http://localhost:5110"
          }
        }
      },
      "gameengine-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5290"
          }
        }
      }
    }
  }
}
